# Sjabloon voor het Mastra agent-project. Kopieer naar .env en vul je eigen waarden in.
# .env staat in .gitignore en wordt NOOIT gecommit.

# Model-provider (kies wat de workshop voorschrijft)
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Browser Use Cloud — haal een key op via je Browser Use-account
BROWSER_USE_API_KEY=

# Doelwit voor de browser-agent (de gedeployde CloudCtrl web-app)
CLOUDCTRL_URL=https://cloud-ctrl-chi.vercel.app
